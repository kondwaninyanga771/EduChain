// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String   @id @default(uuid())
  fullName              String
  email                 String   @unique
  passwordHash          String
  role                  String   // "STUDENT", "LECTURER", "ADMIN"
  walletAddress         String?
  isEmailVerified       Boolean  @default(false)
  verificationToken     String?
  failedLoginAttempts   Int      @default(0)
  accountLockedUntil    DateTime?
  passwordResetToken    String?
  passwordResetExpiry   DateTime?
  nonce                 String?  // For web3 wallet auth
  currentSessionId      String?  // Enforces single-device login
  
  // Student Specific Fields
  programId             String?
  program               Program? @relation(fields: [programId], references: [id])
  year                  Int?
  semester              Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  enrollments           CourseEnrollment[]
  lecturedCourses       CourseLecturer[]
  assessments           Assessment[]       @relation("AssessmentCreator")
  submissions           Submission[]
  gradesGiven           Grade[]            @relation("GradeAssessor")
  logs                  SystemLog[]
  refreshTokens         RefreshToken[]
}

model RefreshToken {
  id          String   @id @default(uuid())
  token       String   @unique
  userId      String
  deviceInfo  String?
  ipAddress   String?
  expiresAt   DateTime
  revoked     Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id               String   @id @default(uuid())
  courseCode       String   @unique
  courseName       String
  description      String?
  createdAt        DateTime @default(now())

  // Relations
  enrollments      CourseEnrollment[]
  lecturers        CourseLecturer[]
  assessments      Assessment[]
  programs         Program[]
}

model CourseEnrollment {
  studentId        String
  courseId         String
  status           String   @default("APPROVED") // "PENDING", "APPROVED", "REJECTED"
  enrolledAt       DateTime @default(now())

  // Relations
  student          User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([studentId, courseId])
}

model CourseLecturer {
  lecturerId       String
  courseId         String
  assignedAt       DateTime @default(now())

  // Relations
  lecturer         User     @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([lecturerId, courseId])
}

model Assessment {
  id                  String   @id @default(uuid())
  courseId            String
  createdByLecturerId String
  title               String
  description         String?
  type                String   @default("FILE_UPLOAD") // "FILE_UPLOAD" or "QUIZ"
  ipfsHash            String?  // Pointer to file on IPFS
  fileName            String?  // Original file name
  questionsJson       String?  // Serialized array of questions for quizzes
  dueDate             DateTime
  blockchainTxHash    String?  // Transaction hash for assessment creation
  createdAt           DateTime @default(now())

  // Relations
  course              Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creator             User         @relation("AssessmentCreator", fields: [createdByLecturerId], references: [id], onDelete: Cascade)
  submissions         Submission[]
}

model Submission {
  id               String   @id @default(uuid())
  assessmentId     String
  studentId        String
  ipfsHash         String?  // Pointer to file on IPFS (optional for quizzes)
  fileName         String?  // Optional for quizzes
  answersJson      String?  // Serialized array of answers for quizzes
  submittedAt      DateTime @default(now())
  status           String   @default("PENDING") // "PENDING", "GRADED"
  blockchainTxHash String?  // Transaction hash for student submission

  // Relations
  assessment       Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student          User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grade            Grade?
}

model Grade {
  id                  String   @id @default(uuid())
  submissionId        String   @unique
  gradedByLecturerId  String
  score               Float
  feedback            String?
  blockchainTxHash    String?  // The immutable proof of grading on Ethereum
  gradedAt            DateTime @default(now())

  // Relations
  submission          Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  grader              User       @relation("GradeAssessor", fields: [gradedByLecturerId], references: [id], onDelete: Cascade)
}

model SystemLog {
  id               String   @id @default(uuid())
  userId           String
  actionType       String   // "LOGIN", "ASSESSMENT_CREATED", "GRADE_PUBLISHED"
  description      String
  timestamp        DateTime @default(now())
  ipAddress        String?

  // Relations
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Program {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  department  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  courses     Course[]
  students    User[]
}
